# ---------- Server ----------
PORT=10000
NODE_ENV=production
LOG_LEVEL=info

# ---------- CORS ----------
CORS_ORIGINS=https://yourusername.github.io,http://localhost:5173

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
ISSUE_RATE_LIMIT_MAX=30

# ---------- JWT ----------
JWT_SECRET=REPLACE_WITH_128_HEX_CHARS
JWT_EXPIRES_IN=12h

# ---------- Master encryption key (AES-256-GCM for Root CA private key) ----------
MASTER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ---------- Admin bootstrap ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_8

# ---------- Firebase Admin SDK (Firestore only — no Storage) ----------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...REPLACE_ME...\n-----END PRIVATE KEY-----\n"
